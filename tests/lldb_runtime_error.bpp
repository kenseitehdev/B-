// LLDB interop fixture: source stepping through a loop and nested procedure
// calls, followed by a deliberate null-pointer load for a SIGSEGV stop.
define proc accumulate(limit) {
    new byte index = 0;
    new byte total = 0;
    while (index < limit) {
        total = total + index;
        index = index + 1;
    }
    return total;
}

define proc read_invalid_address(value) {
    new ptr address = 0;
    return address[0] + value; // Deliberate invalid load for LLDB.
}

define proc main() {
    new byte limit = 4;
    new byte total = accumulate(limit);
    return read_invalid_address(total);
}
