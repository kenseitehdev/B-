// Raw byte/pointer equivalent of the former dynamic string/array fixture.
// The compiler sees no String or Array feature: every buffer is user memory.
define macro "String" "ptr";
define macro "StrArray" "ptr";

define proc main() {
    new ptr raw = malloc 4;
    raw[0] = 65;
    raw[1] = 66;
    raw = remalloc raw 8;
    raw[2] = 67;
    free raw;
    delete raw;

    new String alpha = malloc 6;
    alpha[0] = 97;
    alpha[1] = 108;
    alpha[2] = 112;
    alpha[3] = 104;
    alpha[4] = 97;
    alpha[5] = 10;

    new String beta = malloc 5;
    beta[0] = 98;
    beta[1] = 101;
    beta[2] = 116;
    beta[3] = 97;
    beta[4] = 10;

    new String gamma = malloc 6;
    gamma[0] = 103;
    gamma[1] = 97;
    gamma[2] = 109;
    gamma[3] = 109;
    gamma[4] = 97;
    gamma[5] = 10;

    print alpha, 6;
    print beta, 5;
    print gamma, 6;

    free alpha;
    delete alpha;
    free beta;
    delete beta;
    free gamma;
    delete gamma;
    return 0;
}
