diff --git a/tests/test_source.c b/tests/test_source.c
new file mode 100644
index 0000000..a13bf52
--- /dev/null
+++ b/tests/test_source.c
@@ -0,0 +1,56 @@
+#include "compiler.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+int main(void) {
+    BLCompiler c={0};BLIRModule m;bl_ir_init(&m);
+    assert(bl_compile_file(&c,"tests/debug/main.bpp",&m));
+    assert(m.sources.file_count==3&&m.sources.context_count==3);
+    assert(strstr(m.sources.files[0].path,"/main.bpp"));
+    assert(strstr(m.sources.files[1].path,"/work.bpp"));
+    assert(strstr(m.sources.files[2].path,"/leaf.bpp"));
+    assert(m.sources.contexts[0].parent==0);
+    assert(m.sources.contexts[1].parent==1&&m.sources.contexts[1].line==1);
+    assert(m.sources.contexts[2].parent==2&&m.sources.contexts[2].line==1);
+    assert(m.functions[0].span.file==1);
+    size_t leaf=0,work=0;
+    for(size_t f=0;f<m.function_count;++f){if(!strcmp(m.functions[f].name,"leaf"))leaf=f;if(!strcmp(m.functions[f].name,"work"))work=f;}
+    assert(leaf&&work);
+    assert(m.functions[leaf].span.file==3&&m.functions[leaf].span.line==1);
+    assert(m.functions[leaf].span.end_line==4);
+    assert(m.functions[leaf].local_debug[0].span.file==3);
+    assert(m.functions[leaf].local_debug[0].span.column==18);
+    assert(!strcmp(m.functions[work].local_debug[1].type_name,"int"));
+    assert(bpp_ir_optimize(&m));
+    for(size_t f=0;f<m.function_count;++f)for(size_t b=0;b<m.functions[f].block_count;++b)for(size_t k=0;k<m.functions[f].blocks[b].count;++k){
+        const BLIRInst *i=&m.functions[f].blocks[b].insts[k];
+        if(!i->span.file)continue; /* synthetic null return */
+        assert(i->span.file<=3&&i->span.context<=3);
+        assert(i->span.line>0&&i->span.end_line>=i->span.line);
+        assert(i->line>=i->span.line&&i->line<=i->span.end_line);
+        assert(i->span.end_line>i->span.line||i->span.end_column>i->span.column);
+    }
+    bl_ir_dispose(&m);
+    /* Imported lines must not shift diagnostics for subsequent root code. */
+    assert(!bl_compile_source(&c,"tests/debug/main.bpp","import \"work.bpp\";\nreturn missing;\n",&m));
+    assert(strstr(c.last_error,"main.bpp:2:8:"));
+    assert(!bl_compile_source(&c,"tests/debug/main.bpp","import \"work.bpp\";\nnew int x=;\n",&m));
+    assert(strstr(c.last_error,"main.bpp:2:"));
+    /* Existing macros are declarations discarded by the parser, not expansion.
+     * They must not perturb the following statement's source coordinates. */
+    assert(bl_compile_source(&c,"tests/debug/main.bpp","define macro name \"ignored\";\nreturn 7;\n",&m));
+    assert(m.functions[0].blocks[0].insts[0].span.line==2);
+    assert(bl_compile_source(&c,"tests/debug/main.bpp","return \"a\nb\";",&m));
+    const BLIRInst *string=&m.functions[0].blocks[0].insts[0];
+    assert(string->op==BL_IR_STRING);
+    assert(string->span.line==1&&string->span.column==8);
+    assert(string->span.end_line==2&&string->span.end_column==3);
+    assert(bl_compile_source(&c,NULL,NULL,&m));
+    assert(m.sources.file_count==1&&m.sources.line_count==0);
+    assert(m.functions[0].blocks[0].insts[0].span.file==0);
+    assert(m.functions[0].blocks[0].insts[1].span.file==0);
+    bl_ir_dispose(&m);bl_compiler_dispose(&c);
+    puts("Original source spans and nested import provenance tests passed");
+    return 0;
+}
