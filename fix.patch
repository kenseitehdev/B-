diff --git a/tests/check_debug_metadata.sh b/tests/check_debug_metadata.sh
new file mode 100644
index 0000000..8e0f6be
--- /dev/null
+++ b/tests/check_debug_metadata.sh
@@ -0,0 +1,148 @@
+#!/bin/sh
+# Strict, explicit gate: missing inspection tools fail, rather than silently skip.
+set -eu
+compiler=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
+assembler=${BPP_ASSEMBLER:-clang}
+dwarfdump=${BPP_DWARFDUMP:-llvm-dwarfdump}
+readobj=${BPP_READOBJ:-llvm-readobj}
+readelf=${BPP_READELF:-readelf}
+for tool in "$assembler" "$dwarfdump" "$readobj"; do command -v "$tool" >/dev/null; done
+task_dir=$(mktemp -d)
+cleanup() {
+    status=$?
+    if [ "$status" -ne 0 ]; then
+        for log in "$task_dir/verify" "$task_dir/gdb.log" "$task_dir/lldb.log" "$task_dir/gdb-error.log" "$task_dir/lldb-error.log" "$task_dir/gdb-unwind.log" "$task_dir/error.log"; do
+            if [ -f "$log" ]; then cat "$log" >&2; fi
+        done
+    fi
+    rm -rf "$task_dir"
+    exit "$status"
+}
+trap cleanup EXIT
+trap 'exit 1' HUP INT TERM
+"$compiler" --list-targets > "$task_dir/targets"
+count=0
+while IFS="$(printf '\t')" read -r target triple format rest; do
+    for mode in optimized baseline; do
+        if [ "$mode" = baseline ]; then set -- --no-opt; else set --; fi
+        object="$task_dir/$target-$mode.o"
+        "$compiler" --debug-info --target "$target" --emit-asm "$@" -o "$task_dir/input.s" tests/debug/main.bpp
+        "$assembler" -target "$triple" -g -x assembler -c "$task_dir/input.s" -o "$object"
+        "$readobj" --sections --unwind "$object" > "$task_dir/sections"
+        if [ "$target" = windows-x86_64 ]; then
+            "$readobj" --codeview "$object" > "$task_dir/metadata"
+            grep -F 'DisplayName: work' "$task_dir/metadata" >/dev/null
+            grep -F 'VarName: count' "$task_dir/metadata" >/dev/null
+            grep -F 'DefRangeRegisterRelSym' "$task_dir/metadata" >/dev/null
+            grep -F 'work.bpp' "$task_dir/metadata" >/dev/null
+            grep -F 'leaf.bpp' "$task_dir/metadata" >/dev/null
+            grep -F 'UnwindInfo' "$task_dir/sections" >/dev/null
+        else
+            "$dwarfdump" --verify "$object" > "$task_dir/verify" 2>&1
+            grep -F 'No errors.' "$task_dir/verify" >/dev/null
+            "$dwarfdump" --debug-info --debug-loc --debug-line "$object" > "$task_dir/metadata"
+            grep -F 'DW_TAG_formal_parameter' "$task_dir/metadata" >/dev/null
+            grep -F 'DW_TAG_variable' "$task_dir/metadata" >/dev/null
+            grep -F 'DW_AT_location' "$task_dir/metadata" >/dev/null
+            grep -F 'DW_OP_breg' "$task_dir/metadata" >/dev/null
+            grep -F 'work.bpp' "$task_dir/metadata" >/dev/null
+            grep -F 'leaf.bpp' "$task_dir/metadata" >/dev/null
+            if [ "$target" = linux-x86_64 ] || [ "$target" = linux-arm64 ]; then
+                "$readelf" --debug-dump=info,loc,decodedline,frames,macro "$object" > "$task_dir/elf"
+                grep -F 'DW_TAG_subprogram' "$task_dir/elf" >/dev/null
+                grep -F 'DW_CFA_def_cfa' "$task_dir/elf" >/dev/null
+                [ "$(grep -c 'DW_MACINFO_start_file' "$task_dir/elf")" = 3 ]
+                [ "$(grep -c 'DW_MACINFO_end_file' "$task_dir/elf")" = 3 ]
+            fi
+        fi
+        # Synthesized null/return instructions have no source span; an empty
+        # procedure still needs valid procedure and line-table records.
+        "$compiler" --debug-info --target "$target" --emit-asm "$@" -o "$task_dir/empty.s" tests/debug/empty.bpp
+        "$assembler" -target "$triple" -g -x assembler -c "$task_dir/empty.s" -o "$task_dir/empty.o"
+        if [ "$target" = windows-x86_64 ]; then
+            "$readobj" --codeview "$task_dir/empty.o" > "$task_dir/empty-metadata"
+            grep -F 'DisplayName: empty' "$task_dir/empty-metadata" >/dev/null
+        else
+            "$dwarfdump" --verify "$task_dir/empty.o" > "$task_dir/verify" 2>&1
+            grep -F 'No errors.' "$task_dir/verify" >/dev/null
+        fi
+        count=$((count+1))
+    done
+done < "$task_dir/targets"
+[ "$count" = 8 ]
+
+# Both host debuggers must read the same live values and refuse the former owner
+# of a recycled slot. File/line stepping must enter an original imported file.
+"$compiler" --debug-info --print-result -o "$task_dir/program" tests/debug/main.bpp
+actual=$("$task_dir/program")
+[ "$actual" = "$(printf '6\n6')" ]
+"$dwarfdump" --verify "$task_dir/program" > "$task_dir/verify" 2>&1
+for backend in native c; do
+    "$compiler" --debug-info --backend "$backend" -o "$task_dir/error-$backend" tests/debug/error-main.bpp
+    if "$task_dir/error-$backend" > "$task_dir/error.out" 2> "$task_dir/error.log"; then
+        echo "Runtime error unexpectedly succeeded ($backend)" >&2;exit 1
+    fi
+    grep -F 'error-lib.bpp:2:13: division by zero' "$task_dir/error.log" >/dev/null
+done
+debuggers=${BPP_DEBUGGERS:-gdb,lldb}
+case ",$debuggers," in
+    *,gdb,*)
+        gdb=${BPP_GDB:-gdb}
+        cat > "$task_dir/gdb.commands" <<'GDB'
+set pagination off
+set disable-randomization off
+break work
+run
+printf "ENTRY_N=%lld\n", n.as.i
+print count
+break work.bpp:6
+continue
+printf "LOOP_COUNT=%lld SUM=%lld\n", count.as.i, sum.as.i
+print n
+step
+bt
+break leaf
+continue
+bt
+GDB
+        "$gdb" -q -batch -x "$task_dir/gdb.commands" "$task_dir/program" > "$task_dir/gdb.log" 2>&1
+        grep -F 'ENTRY_N=3' "$task_dir/gdb.log" >/dev/null
+        grep -F 'LOOP_COUNT=3 SUM=0' "$task_dir/gdb.log" >/dev/null
+        grep -F '<optimized out>' "$task_dir/gdb.log" >/dev/null
+        grep -F 'leaf.bpp:2' "$task_dir/gdb.log" >/dev/null
+        # Two recursive source frames, in addition to the caller and module.
+        [ "$(grep -Ec '^#[0-9]+.*leaf .*leaf.bpp' "$task_dir/gdb.log")" -ge 3 ]
+        "$gdb" -q -batch -ex 'set disable-randomization off' -ex 'break fail' \
+            -ex run -ex 'break bpp_a_op' -ex continue -ex bt -ex continue \
+            "$task_dir/error-native" > "$task_dir/gdb-error.log" 2>&1
+        grep -F 'error-lib.bpp:2' "$task_dir/gdb-error.log" >/dev/null
+        grep -F 'division by zero' "$task_dir/gdb-error.log" >/dev/null
+        "$gdb" -q -batch -ex 'set disable-randomization off' -ex 'break *work' \
+            -ex run -ex bt -ex 'break *L_cleanup_2' -ex continue -ex bt \
+            -ex 'break main.bpp:3' -ex continue \
+            -ex 'printf "ROOT_RESULT=%lld\n", result.as.i' \
+            "$task_dir/program" > "$task_dir/gdb-unwind.log" 2>&1
+        [ "$(grep -c 'in <module>' "$task_dir/gdb-unwind.log")" -ge 2 ]
+        grep -F 'ROOT_RESULT=6' "$task_dir/gdb-unwind.log" >/dev/null
+        ;;
+esac
+case ",$debuggers," in
+    *,lldb,*)
+        lldb=${BPP_LLDB:-lldb}
+        "$lldb" -b -o 'settings set target.disable-aslr false' \
+            -o 'breakpoint set --file work.bpp --line 6' -o run \
+            -o 'frame variable count sum n' -o 'thread step-in' -o bt \
+            "$task_dir/program" > "$task_dir/lldb.log" 2>&1
+        grep -F 'i = 3' "$task_dir/lldb.log" >/dev/null
+        grep -F 'i = 0' "$task_dir/lldb.log" >/dev/null
+        grep -F 'variable not available' "$task_dir/lldb.log" >/dev/null
+        grep -F 'leaf.bpp:2' "$task_dir/lldb.log" >/dev/null
+        "$lldb" -b -o 'settings set target.disable-aslr false' \
+            -o 'breakpoint set --name fail' -o run \
+            -o 'breakpoint set --name bpp_a_op' -o continue -o bt -o continue \
+            "$task_dir/error-native" > "$task_dir/lldb-error.log" 2>&1
+        grep -F 'error-lib.bpp:2' "$task_dir/lldb-error.log" >/dev/null
+        grep -F 'division by zero' "$task_dir/lldb-error.log" >/dev/null
+        ;;
+esac
+printf 'Passed metadata inspection for %s target/mode pairs; selected host debugger checks: %s\n' "$count" "$debuggers"
