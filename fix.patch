+++ b/tests/debug/work.bpp
@@ -0,0 +1,10 @@
+import "leaf.bpp";
+define proc work(n) {
+    new int count=n;
+    new int sum=0;
+    while(count>0) {
+        sum=sum+leaf(count);
+        count=count-1;
+    }
+    return sum;
+}
