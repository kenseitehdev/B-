@@ -0,0 +1,27 @@
+#!/bin/sh
+# Metadata round trip only. These link stubs are never executed and do not
+# establish Windows runtime or debugger support.
+set -eu
+compiler=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
+assembler=${BPP_ASSEMBLER:-clang}
+linker=${BPP_LLD_LINK:-lld-link}
+pdbutil=${BPP_PDBUTIL:-llvm-pdbutil}
+for tool in "$assembler" "$linker" "$pdbutil"; do command -v "$tool" >/dev/null; done
+task_dir=$(mktemp -d)
+trap 'rm -rf "$task_dir"' EXIT HUP INT TERM
+"$compiler" --debug-info --target windows-x86_64 --emit-asm -o "$task_dir/program.s" tests/debug/main.bpp
+"$assembler" -target x86_64-pc-windows-msvc -c "$task_dir/program.s" -o "$task_dir/program.obj"
+awk '$1 == "call" && $2 !~ /^L_/ {print $2}' "$task_dir/program.s" > "$task_dir/helpers.unsorted"
+sort -u "$task_dir/helpers.unsorted" > "$task_dir/helpers"
+printf '.text\n' > "$task_dir/stubs.s"
+while read -r symbol; do printf '.globl %s\n%s:\n ret\n' "$symbol" "$symbol" >> "$task_dir/stubs.s"; done < "$task_dir/helpers"
+"$assembler" -target x86_64-pc-windows-msvc -c "$task_dir/stubs.s" -o "$task_dir/stubs.obj"
+"$linker" /entry:main /nodefaultlib /subsystem:console /debug \
+    "/out:$task_dir/metadata-only.exe" "/pdb:$task_dir/program.pdb" \
+    "$task_dir/program.obj" "$task_dir/stubs.obj"
+"$pdbutil" dump -types -symbols -l "$task_dir/program.pdb" > "$task_dir/pdb.txt"
+grep -F 'work' "$task_dir/pdb.txt" >/dev/null
+grep -F 'count' "$task_dir/pdb.txt" >/dev/null
+grep -F 'BLValue' "$task_dir/pdb.txt" >/dev/null
+grep -F 'work.bpp' "$task_dir/pdb.txt" >/dev/null
+printf 'Passed CodeView-to-PDB metadata round trip (no Windows execution)\n'
